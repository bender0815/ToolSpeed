rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /tools/{toolId} {
        allow read, write: if isOwner(userId) && isValidId(toolId);
      }

      match /lathes/{latheId} {
        allow read, write: if isOwner(userId) && isValidId(latheId);
      }

      match /jobs/{jobId} {
        allow read, write: if isOwner(userId) && isValidId(jobId);
      }

      match /custom_materials/{materialId} {
        allow read, write: if isOwner(userId) && isValidId(materialId);
      }
    }
  }
}
